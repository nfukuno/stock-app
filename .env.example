# コピーして .env にリネームして使う（.env は .gitignore 済み。コミットしないこと）

# 予想の保存先: github（本番・ローカルアプリから GitHub に直接保存）/ local（作業ツリーのファイル）
FORECAST_STORAGE=github
# fine-grained PAT（対象: nfukuno/stock-app のみ / 権限: Contents = Read and write）
FORECAST_GITHUB_TOKEN=
FORECAST_GITHUB_REPO=nfukuno/stock-app
FORECAST_GITHUB_BRANCH=main
# local 時のルート。省略時は <repo>/forecasts
# FORECAST_DATA_DIR=

# 採点ジョブの LINE 通知（通常は GitHub Actions の secrets を使う。手元で試すときのみ）
# LINE_ACCESS_TOKEN=
# LINE_USER_ID=
